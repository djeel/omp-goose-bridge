# OMP Bridge — variables d'environnement (toutes optionnelles)

# Binaire OMP (par défaut : "omp", résolu via PATH)
# OMP_BIN=/usr/local/bin/omp

# Racines autorisées pour les workspaces, séparées par ":" (défaut : cwd + /tmp)
# OMP_BRIDGE_ROOTS=/home/me/projets:/tmp

# Workspace par défaut si l'appelant n'en fournit pas (défaut : cwd)
# OMP_BRIDGE_WORKSPACE=/home/me/projets/mon-app

# Base SQLite de l'historique (défaut : <repo>/data/bridge.db)
# OMP_BRIDGE_DB=/home/me/.local/share/omp-bridge/bridge.db

# Panneau HTTP : bind localhost par défaut (ne jamais exposer sur le LAN)
# OMP_BRIDGE_HTTP=3210
# OMP_BRIDGE_HTTP_HOST=127.0.0.1

# Rétention max d'événements (défaut : 20000)
# OMP_BRIDGE_EVENTS_MAX=20000

# Arrêt automatique des sessions inactives, en secondes (défaut : 1800)
# OMP_BRIDGE_SESSION_TTL=1800

# Timeout d'un prompt OMP, en secondes (défaut : 300)
# OMP_BRIDGE_PROMPT_TIMEOUT=300

# Taille max d'une réponse renvoyée à Goose, en caractères (défaut : 12000)
# OMP_BRIDGE_MAX_OUTPUT=12000

# Logs détaillés sur stderr (défaut : 0)
# OMP_BRIDGE_VERBOSE=1

# Token partagé du panneau HTTP (défaut : vide = pas d'auth, bind localhost only)
# OMP_BRIDGE_TOKEN=s3cret

# Dossier des fichiers de session OMP autorisés en reprise (défaut : ~/.local/share/omp-bridge/sessions)
# OMP_BRIDGE_SESSIONS_DIR=/home/me/.local/share/omp-bridge/sessions
