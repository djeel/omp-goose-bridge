{
  "name": "omp-goose-bridge",
  "version": "1.2.0",
  "description": "Bridge RPC entre Goose (orchestrateur) et OMP (moteur) — sessions, rôles read-only/writer, panneau MCP App",
  "type": "module",
  "license": "MIT",
  "author": "djeel",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/djeel/omp-goose-bridge.git"
  },
  "homepage": "https://github.com/djeel/omp-goose-bridge#readme",
  "bugs": {
    "url": "https://github.com/djeel/omp-goose-bridge/issues"
  },
  "keywords": [
    "goose",
    "mcp",
    "model-context-protocol",
    "omp",
    "ai-agent",
    "rpc",
    "mcp-app"
  ],
  "engines": {
    "bun": ">=1.1.0"
  },
  "files": [
    "src",
    "recipes",
    "agents",
    "scripts",
    "examples",
    "CHANGELOG.md",
    "ARCHITECTURE.md",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "mcp": "bun src/mcp/server.ts",
    "panel": "bun src/apps/serve.ts",
    "probe": "bun src/rpc/probe.ts",
    "check": "tsc --noEmit",
    "lint": "biome lint .",
    "bench": "bun scripts/bench.ts",
    "test": "bun test",
    "ci": "tsc --noEmit && biome lint . && bun test",
    "install:goose": "bash scripts/install.sh",
    "prepublishOnly": "bun run ci"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@types/bun": "^1.4.5",
    "typescript": "^7.0.2"
  },
  "bin": {
    "omp-goose-bridge": "src/mcp/server.ts"
  }
}
